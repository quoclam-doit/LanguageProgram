{
  "name": "language-learning-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "dev:backend": "pnpm --filter @app/backend dev",
    "dev:frontend": "pnpm --filter @app/frontend dev",
    "build:shared": "pnpm --filter @app/shared build",
    "build:backend": "pnpm --filter @app/backend build",
    "build:frontend": "pnpm --filter @app/frontend build",
    "build": "pnpm build:shared && pnpm build:backend && pnpm build:frontend",
    "test": "pnpm --filter @app/shared build && pnpm --filter @app/backend test",
    "dev": "pnpm --filter @app/shared build && pnpm --parallel --filter @app/backend --filter @app/frontend dev"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
